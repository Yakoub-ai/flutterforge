# FlutterForge — normalize line endings across platforms
# All text files stored as LF in the repo; checked out as-is on all platforms.

* text=auto eol=lf

# Force LF for shell scripts so they execute on macOS/Linux without issues
*.sh text eol=lf
*.ps1 text eol=crlf

# Force LF for JS/JSON/Markdown
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary — no line-ending conversion
*.png binary
*.jpg binary
*.ico binary
*.zip binary
